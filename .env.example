# Platform URLs
PLATFORM_API_URL=http://localhost:4100
PLATFORM_WEB_URL=http://localhost:3000

# AAIS free cloud text (optional — never commit real keys)
# OpenRouter Free Models Router: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://github.com/warheart1984-ctrl/AAES-OS
OPENROUTER_SITE_NAME=AAES-OS AAIS
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Local Ollama (default)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# AAIS free cloud image (optional — never commit real keys)
# Pollinations: keyless via pnpm aais --image "…" (default provider)
# Gemini image (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # accepted as an alias for GEMINI_API_KEY
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Google Drive OAuth (do not commit real values)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback
GOOGLE_DRIVE_SCOPES=openid email profile https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_STATE_SECRET=generate-a-long-random-value
GOOGLE_DRIVE_TOKEN_KEY=generate-a-separate-long-random-value
GOOGLE_DRIVE_TOKEN_VAULT=.local/google-drive/tokens.json
GOOGLE_DRIVE_EVIDENCE_LOG=.local/google-drive/evidence.jsonl
