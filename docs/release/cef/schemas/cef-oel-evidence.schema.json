{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aaes-os.local/schemas/cef-oel-evidence.schema.json",
  "title": "CEF OEL Evidence Profile v1.0",
  "allOf": [
    { "$ref": "cef-core-evidence.schema.json" },
    {
      "type": "object",
      "required": ["type", "oel"],
      "properties": {
        "type": { "const": "OEL" },
        "oel": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "deploymentId",
            "commitSha",
            "containerDigest",
            "immutableTag",
            "sbomRef",
            "supplyChainFacts",
            "vulnerabilityScan",
            "securityGates",
            "conformanceTests",
            "runtimeHealth",
            "policyValidation"
          ],
          "properties": {
            "deploymentId": { "type": "string" },
            "commitSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            "containerDigest": {
              "description": "sha256 digest or pending sentinel",
              "type": "string"
            },
            "immutableTag": { "type": "string" },
            "sbomRef": { "type": "string" },
            "supplyChainFacts": { "type": "object" },
            "vulnerabilityScan": { "type": "object" },
            "securityGates": { "type": "object" },
            "conformanceTests": {
              "type": "object",
              "required": ["passed", "total"],
              "properties": {
                "passed": { "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 0 }
              }
            },
            "runtimeHealth": { "type": "object" },
            "policyValidation": {
              "type": "object",
              "required": ["netpol", "rbac", "securityContext"],
              "properties": {
                "netpol": { "type": "string" },
                "rbac": { "type": "string" },
                "securityContext": { "type": "string" }
              }
            }
          }
        }
      }
    }
  ]
}
