{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aaes-os.local/schemas/operational-evidence-record.schema.json",
  "title": "AAES-OS Operational Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "baselineId",
    "version",
    "commitSha",
    "containerDigests",
    "sbom",
    "vulnerabilityScan",
    "conformanceTests",
    "runtimeHealth",
    "promotionDecision",
    "approvalSignature",
    "timestamp",
    "truthBoundary"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "recordId": { "type": "string", "minLength": 1 },
    "baselineId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "containerDigests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "image", "digestStatus"],
        "properties": {
          "service": { "type": "string" },
          "image": { "type": "string" },
          "digest": { "type": ["string", "null"] },
          "digestStatus": {
            "type": "string",
            "enum": ["pinned", "pending", "mutable-tag-only", "waived"]
          }
        }
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "present", "pending", "waived"]
        },
        "format": { "type": ["string", "null"] },
        "artifactUri": { "type": ["string", "null"] },
        "waiverReason": { "type": ["string", "null"] }
      }
    },
    "vulnerabilityScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tool"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "PASS_WITH_ACCEPTED_RISK", "FAIL", "PENDING"]
        },
        "tool": { "type": "string" },
        "artifactUri": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] }
      }
    },
    "conformanceTests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "status"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "PENDING", "PARTIAL"]
        },
        "suiteId": { "type": ["string", "null"] }
      }
    },
    "runtimeHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "services"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["healthy", "degraded", "unhealthy", "pending"]
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service", "liveness", "readiness"],
            "properties": {
              "service": { "type": "string" },
              "liveness": { "type": "string", "enum": ["pass", "fail", "pending"] },
              "readiness": { "type": "string", "enum": ["pass", "fail", "pending"] }
            }
          }
        }
      }
    },
    "policyValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "PENDING"]
        },
        "checks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "promotionDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "authority"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["promote", "hold", "deny", "pending"]
        },
        "authority": { "type": "string" },
        "rationale": { "type": ["string", "null"] },
        "failingGates": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "approvalSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "signer"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["signed", "unsigned", "pending"]
        },
        "signer": { "type": "string" },
        "signedAt": { "type": ["string", "null"], "format": "date-time" },
        "method": { "type": ["string", "null"] },
        "signatureRef": { "type": ["string", "null"] }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "proofSurfaceLevel": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3", "P4", "P5"]
    },
    "truthBoundary": { "type": "string", "minLength": 1 },
    "challengeSurface": {
      "type": "array",
      "items": { "type": "string" }
    },
    "relatedArtifacts": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
