    "@types/jest": "^29.2.0",
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.71.0",
    "babel-jest": "^29.3.0",
    "eslint": "^8.31.0",
    "jest": "^29.3.0",
    "metro-react-native-babel-preset": "^0.73.0",
    "typescript": "^4.9.0"
